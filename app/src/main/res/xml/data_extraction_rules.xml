<?xml version="1.0" encoding="utf-8"?>
<!--
   Financial data (the Room database - transactions, balances, budgets) is excluded from
   Android's cloud auto-backup so it never leaves the device via the user's Google account
   backup. It's still allowed on device-transfer (the guided phone-to-phone Switch/restore
   flow), since that's a controlled, user-initiated local transfer rather than a cloud copy.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
