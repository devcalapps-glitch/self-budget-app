<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy Auto Backup rules for devices below API 31 (API 31+ uses data_extraction_rules.xml
   instead). Excludes the Room database (transactions, balances, budgets) from backup for the
   same reason: financial data shouldn't silently ride along in the device's default backup.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="." />
</full-backup-content>
