<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Modern Edge-to-Edge Material3 Theme for Self Budget App -->
    <style name="Theme.SelfBudget" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Transparent System Bars for Edge-to-Edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Android 12+ Seamless Cold Start Splash Screen -->
        <item name="android:windowSplashScreenBackground">#123A33</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_app_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#123A33</item>
    </style>
</resources>